{
  "$description": "Shop De Bie design tokens (homepage v2). Source of truth for colours, type, spacing.",
  "color": {
    "turquoise": { "value": "#1BB0CE", "note": "Brand fill. Never text on light backgrounds." },
    "ink": { "value": "#0B2730", "note": "Text, dark sections, rules, primary buttons" },
    "ink-hover": { "value": "#123744" },
    "white": { "value": "#FFFFFF" },
    "muted": { "value": "#47616A", "note": "Secondary text on white" },
    "muted-dark": { "value": "#C5D3D7", "note": "Secondary text on ink" },
    "rule": { "value": "#CFDDE1", "note": "Inner hairlines on white" },
    "rule-dark": { "value": "#2A4852", "note": "Hairlines on ink" },
    "tint": { "value": "#D6F0F6", "note": "Today row, map placeholder" },
    "closed": { "value": "#C9533F", "note": "Closed status dot only" }
  },
  "overlay": {
    "hero": "rgba(11,39,48,0.18)",
    "glass-nav": { "background": "rgba(255,255,255,0.80)", "backdropFilter": "blur(24px) saturate(1.3)", "border": "1px solid rgba(255,255,255,0.6)" },
    "glass-panel": { "background": "rgba(255,255,255,0.74)", "backdropFilter": "blur(28px) saturate(1.3)", "border": "1px solid rgba(255,255,255,0.6)" },
    "glass-fallback": "rgba(255,255,255,0.94)"
  },
  "font": {
    "sans": { "family": "Instrument Sans", "source": "Google Fonts", "axes": { "wght": "400..700", "wdth": "75..100" } },
    "mono": { "family": "IBM Plex Mono", "source": "Google Fonts", "weights": [400, 500] }
  },
  "type": {
    "h1": { "size": "clamp(64px, 8vw, 112px)", "weight": 600, "stretch": "78%", "tracking": "-0.035em", "leading": 0.86 },
    "h2": { "size": "clamp(48px, 6vw, 88px)", "weight": 600, "stretch": "78%", "tracking": "-0.035em", "leading": 0.88 },
    "feature-title": { "size": "clamp(48px, 5vw, 72px)", "weight": 600, "stretch": "78%", "tracking": "-0.035em", "leading": 0.9 },
    "banner-title": { "size": "clamp(40px, 4vw, 56px)", "weight": 600, "stretch": "78%", "tracking": "-0.035em", "leading": 0.92 },
    "h3-service": { "size": "36px", "weight": 600, "stretch": "80%", "tracking": "-0.03em", "leading": 0.95 },
    "h3-pillar": { "size": "28px", "weight": 600, "stretch": "80%", "tracking": "-0.02em", "leading": 1 },
    "step-title": { "size": "24px", "weight": 600, "stretch": "80%", "tracking": "-0.02em", "leading": 1.1 },
    "stat": { "size": "clamp(36px, 4vw, 56px)", "weight": 600, "stretch": "78%", "tracking": "-0.03em", "leading": 1 },
    "wordmark": { "size": "26px", "weight": 700, "stretch": "80%", "tracking": "-0.02em" },
    "logo-mark": { "size": "22px", "weight": 700, "stretch": "78%", "tracking": "-0.04em", "box": "44px" },
    "lead": { "size": "18px", "weight": 400, "leading": 1.55 },
    "body": { "size": "16px", "weight": 400, "leading": 1.5 },
    "small": { "size": "15px", "weight": 400, "leading": 1.55 },
    "nav": { "size": "15px", "weight": 500 },
    "button": { "size": "15px", "weight": 600 },
    "eyebrow": { "family": "mono", "size": "12px", "tracking": "0.14em", "transform": "uppercase" },
    "number": { "family": "mono", "size": "12px", "tracking": "0.12em" },
    "stat-label": { "family": "mono", "size": "11px", "tracking": "0.1em", "transform": "uppercase" }
  },
  "layout": {
    "container": "1440px",
    "gutter": "clamp(20px, 4.4vw, 64px)",
    "section-y": "clamp(72px, 9vw, 128px)",
    "section-y-loyalty": "clamp(72px, 9vw, 120px)",
    "story-y": "clamp(56px, 7vw, 104px)",
    "header-to-content": "48px",
    "nav-collapse": "900px"
  },
  "radius": { "default": "0", "card": "12px" },
  "border": { "width": "1px" },
  "shadow": { "card": "0 30px 60px -20px rgba(0,0,0,0.55)" },
  "motion": { "hover": "150ms ease", "cardRotate": "-4deg" },
  "focus": { "outline": "2px solid #1BB0CE", "offset": "2px", "onTurquoise": "2px solid #0B2730" }
}
